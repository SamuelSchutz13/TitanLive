PORT=3000
WEB_ORIGIN=http://localhost:5173

# SigNoz (OpenTelemetry). Self-hosted: http://localhost:4318
# SigNoz Cloud: https://ingest.<region>.signoz.cloud:443 + OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>
OTEL_SERVICE_NAME=titanlive-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
# OTEL_SDK_DISABLED=true
